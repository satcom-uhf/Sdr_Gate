{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "openwebrx-settings-route": {
        "ClusterId": "openwebrx-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Order": 1,
        "Match": {
          "Path": "/settings/{**catch-all}"
        }
      },
      "openwebrx-route": {
        "ClusterId": "openwebrx-cluster",
        "AuthorizationPolicy": "default",
        "Order": 2,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "openwebrx-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "04:00:00"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:8073"
          }
        }
      }
    }
  }
}
